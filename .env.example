# Copy to .env and enter your own local values. Never commit .env or real secrets.
# Docker Compose reads .env; the Java application receives the mapped variables.

# Development HTTP publication: loopback only; PostgreSQL has no published port.
# bin/up takes a custom port from the shell: ERBAS_JAVA_PORT=49080 ./bin/up
ERBAS_JAVA_PORT=48080

# Persistent local PostgreSQL. Replace the sample password before first startup.
ERBAS_DB_NAME=erbas_dev
ERBAS_DB_USER=erbas
ERBAS_DB_PASSWORD='replace-with-your-local-database-password'

# Optional initial administrator. Set enabled=true and fill email/password once.
# Java uses ERBAS_AUTH_BOOTSTRAP_PASSWORD, not the .NET ERBAS_CORE_ADMIN_PASSWORD.
# Disable bootstrap and clear its password after creation; it is not a password reset.
ERBAS_AUTH_BOOTSTRAP_ENABLED=false
ERBAS_AUTH_BOOTSTRAP_EMAIL=
ERBAS_AUTH_BOOTSTRAP_PASSWORD=
ERBAS_AUTH_BOOTSTRAP_ADMIN=true
ERBAS_AUTH_ACCESS_TOKEN_TTL=PT1H

# Groq through the generic OpenAI-compatible Chat Completions protocol.
# Full operation URL, not just /openai/v1. Choose a model available to your account.
# Put your Groq API key directly in ERBAS_AI_PROVIDER_CREDENTIAL, without "Bearer ".
# A blank credential keeps this external provider unavailable.
ERBAS_AI_PROVIDER_PROTOCOL=openai-compatible
ERBAS_AI_PROVIDER_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
ERBAS_AI_PROVIDER_MODEL=openai/gpt-oss-20b
ERBAS_AI_PROVIDER_CREDENTIAL=
ERBAS_AI_PROVIDER_TIMEOUT_SECONDS=30
ERBAS_AI_PROVIDER_TRUSTED_LOCAL=false

# Another compatible service only needs its full endpoint, model and credential.
# Keep HTTPS and trusted-local=false for external services. See docs/ai.md.
# Single-quote values containing literal dollar signs or comment characters.
