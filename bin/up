#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root"
[[ $# -eq 0 ]] || { echo 'Usage: ./bin/up' >&2; exit 2; }
for tool in docker timeout; do
    command -v "$tool" >/dev/null || { echo "ERROR: missing host tool: $tool" >&2; exit 2; }
done
export ERBAS_JAVA_PORT="${ERBAS_JAVA_PORT:-48080}"
[[ "$ERBAS_JAVA_PORT" =~ ^[0-9]{1,5}$ ]] &&
    (( 10#$ERBAS_JAVA_PORT >= 1 && 10#$ERBAS_JAVA_PORT <= 65535 )) || {
    echo 'ERROR: ERBAS_JAVA_PORT must be an integer between 1 and 65535.' >&2
    exit 2
}
url="http://127.0.0.1:$ERBAS_JAVA_PORT"
stage='Compose validation'
diagnostics() {
    local code=$?
    trap - ERR
    echo "ERROR: $stage failed (exit $code). Development resources are retained; use ./bin/down to stop them." >&2
    timeout --kill-after=5s 15 docker compose ps >&2 || true
    timeout --kill-after=5s 15 docker compose logs --no-color --tail 40 app postgres >&2 || true
    exit "$code"
}
trap diagnostics ERR
trap 'exit 130' INT
trap 'exit 143' TERM

echo '==> Validating development Compose'
timeout --kill-after=10s 30 docker compose config --quiet
stage='application build'
echo '==> Building Java application'
timeout --kill-after=10s 900 docker compose build app
stage='PostgreSQL/application startup and healthchecks'
echo '==> Starting PostgreSQL and Java'
timeout --kill-after=10s 150 docker compose up --detach --wait --wait-timeout 120 postgres app

stage='published contractual Health readiness'
image="$(timeout --kill-after=5s 15 docker compose images --quiet app)"
[[ -n "$image" ]] || { echo 'ERROR: application image not found.' >&2; false; }
# Reuse curl from the existing runtime image. Linux host networking reaches the
# loopback publication without installing curl or a JSON tool on the host.
deadline=$((SECONDS + 60))
json_pattern='^[[:space:]]*\{[[:space:]]*"status"[[:space:]]*:[[:space:]]*"ok"[[:space:]]*\}[[:space:]]*$'
while :; do
    if response="$(timeout --kill-after=5s 15 docker run --rm --network host --entrypoint curl "$image" \
        --silent --show-error --noproxy '*' --connect-timeout 2 --max-time 5 \
        --header 'Accept: application/json' --write-out '\n%{http_code}\n%{content_type}' "$url/health")"; then
        content_type="${response##*$'\n'}"
        payload="${response%$'\n'*}"
        status="${payload##*$'\n'}"
        body="${payload%$'\n'*}"
        if [[ "$status" == 200 ]]; then
            if [[ "${content_type,,}" =~ ^application/json([[:space:]]*\;.*)?$ && "$body" =~ $json_pattern ]]; then
                break
            fi
            echo 'ERROR: /health returned HTTP 200 but not contractual application/json {"status":"ok"}.' >&2
            false
        fi
        echo "Waiting for /health (HTTP $status)..."
    else
        code=$?
        # Curl transport failures may be transient; Docker/watchdog failures are not.
        if [[ "$code" != 7 && "$code" != 28 && "$code" != 52 && "$code" != 56 ]]; then
            echo "ERROR: Health probe failed (exit $code)." >&2
            exit "$code"
        fi
    fi
    if (( SECONDS >= deadline )); then
        echo "ERROR: /health did not become available within 60 seconds: $url/health" >&2
        false
    fi
    sleep 2
done
printf 'Java is running: %s\nHealth: %s/health (HTTP 200, {"status":"ok"})\n' "$url" "$url"
